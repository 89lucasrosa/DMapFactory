<Window x:Class="DMapFactory.App.Views.FindValueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DMapFactory.App.ViewModels"
        xmlns:loc="clr-namespace:DMapFactory.Localization;assembly=DMapFactory.Localization"
        mc:Ignorable="d"
        Title="{Binding [FindVal_Title], Source={x:Static loc:Loc.Instance}}"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        ShowInTaskbar="False">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding [FindVal_Header], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Style="{StaticResource SecondaryText}" FontSize="11" Text="{Binding [FindVal_Subheader], Source={x:Static loc:Loc.Instance}}" />
            </StackPanel>
        </StackPanel>

        <!-- Formulário de Busca -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Seletor de Tag -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [FindVal_TagLabel], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TagComboBox"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{Binding PenBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Address, StringFormat='({0})'}" Style="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Valor Procurado -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [FindVal_ValueLabel], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="SearchValueTextBox"
                         Padding="6,4" VerticalAlignment="Center"
                         KeyDown="SearchValueTextBox_KeyDown" />

                <!-- Opções de Busca -->
                <WrapPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                    <CheckBox x:Name="ExactMatchCheckBox" Content="{Binding [FindVal_ExactMatch], Source={x:Static loc:Loc.Instance}}" IsChecked="True" Margin="0,0,16,4" VerticalAlignment="Center" />
                    <CheckBox x:Name="OnlyTransitionsCheckBox" Content="{Binding [FindVal_OnlyTransitions], Source={x:Static loc:Loc.Instance}}" IsChecked="False" Margin="0,0,16,4" VerticalAlignment="Center" />
                    <CheckBox x:Name="CaseSensitiveCheckBox" Content="{Binding [FindVal_CaseSensitive], Source={x:Static loc:Loc.Instance}}" IsChecked="False" Margin="0,0,0,4" VerticalAlignment="Center" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Barra de Status e Feedback -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="{StaticResource ControlRadius}" Padding="10,6" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Button x:Name="ViewSwitchButton" DockPanel.Dock="Right" Padding="8,2" Margin="6,0,0,0"
                        Click="ViewSwitchButton_Click" VerticalAlignment="Center" FontSize="11" />
                <TextBlock x:Name="StatusTextBlock" Text="{Binding [FindVal_IdleHint], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Botões de Ação -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="FindPrevButton" Content="{Binding [FindVal_BtnPrev], Source={x:Static loc:Loc.Instance}}" Padding="14,5" Margin="0,0,8,0" Click="FindPrevButton_Click" />
            <Button x:Name="FindNextButton" Content="{Binding [FindVal_BtnNext], Source={x:Static loc:Loc.Instance}}" IsDefault="True" Padding="14,5" Margin="0,0,8,0" Click="FindNextButton_Click"
                    Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            <Button Content="{Binding [FindVal_BtnClose], Source={x:Static loc:Loc.Instance}}" IsCancel="True" Padding="14,5" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
