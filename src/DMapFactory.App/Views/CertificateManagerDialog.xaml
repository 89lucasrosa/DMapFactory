<Window x:Class="DMapFactory.App.Views.CertificateManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DMapFactory.Localization;assembly=DMapFactory.Localization"
        xmlns:services="clr-namespace:DMapFactory.App.Services"
        Title="{Binding [CertDlg_Title], Source={x:Static loc:Loc.Instance}}"
        Width="900" Height="650" MinWidth="740" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        services:HelpProvider.TopicId="IDH_CERTIFICATES">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" Padding="12">

            <!-- ===================================================================== -->
            <!-- ABA 1: CERTIFICADOS DE SERVIDORES OPC UA (TRUSTED / REJECTED)         -->
            <!-- ===================================================================== -->
            <TabItem x:Name="ServerCertsTab" Header="{Binding [CertDlg_Tab_Servers], Source={x:Static loc:Loc.Instance}}">
                <DockPanel>
                    <!-- Barra superior: filtro e opção de auto-aceite -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <CheckBox DockPanel.Dock="Right" x:Name="AutoAcceptServerCertsCheck"
                                  Content="{Binding [CertDlg_AutoAccept], Source={x:Static loc:Loc.Instance}}"
                                  VerticalAlignment="Center"
                                  Checked="AutoAcceptServerCertsCheck_Changed"
                                  Unchecked="AutoAcceptServerCertsCheck_Changed"
                                  ToolTip="{Binding [CertDlg_AutoAccept_Tip], Source={x:Static loc:Loc.Instance}}" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="FilterAllRadio" Content="Todos" IsChecked="True"
                                         GroupName="ServerFilter" VerticalAlignment="Center" Margin="0,0,10,0"
                                         Checked="ServerFilter_Changed" />
                            <RadioButton x:Name="FilterTrustedRadio" Content="Confiáveis"
                                         GroupName="ServerFilter" VerticalAlignment="Center" Margin="0,0,10,0"
                                         Checked="ServerFilter_Changed" />
                            <RadioButton x:Name="FilterRejectedRadio" Content="Rejeitados"
                                         GroupName="ServerFilter" VerticalAlignment="Center" Margin="0,0,12,0"
                                         Checked="ServerFilter_Changed" />
                            <Button Click="RefreshServers_Click" Padding="8,3"
                                    BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                    Content="{Binding [CertDlg_Btn_Refresh], Source={x:Static loc:Loc.Instance}}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Barra de ações inferior -->
                    <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="TrustServerBtn" Click="TrustSelectedServer_Click" Padding="10,5" Margin="0,2,6,2"
                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                Content="{Binding [CertDlg_Btn_Trust], Source={x:Static loc:Loc.Instance}}" />
                        <Button x:Name="RejectServerBtn" Click="RejectSelectedServer_Click" Padding="10,5" Margin="0,2,6,2"
                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                Content="{Binding [CertDlg_Btn_Reject], Source={x:Static loc:Loc.Instance}}" />
                        <Button Click="ImportServerCert_Click" Padding="10,5" Margin="0,2,6,2"
                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                Content="{Binding [CertDlg_Btn_ImportServer], Source={x:Static loc:Loc.Instance}}" />
                        <Button x:Name="ExportServerBtn" Click="ExportSelectedServerCert_Click" Padding="10,5" Margin="0,2,6,2"
                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                Content="{Binding [CertDlg_Btn_ExportServer], Source={x:Static loc:Loc.Instance}}" />
                        <Button x:Name="RemoveServerBtn" Click="RemoveSelectedServerCert_Click" Padding="10,5" Margin="0,2,6,2"
                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                Content="{Binding [CertDlg_Btn_DeleteServer], Source={x:Static loc:Loc.Instance}}" />
                        <Button Click="OpenPkiFolder_Click" Padding="10,5" Margin="0,2,0,2"
                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                Content="{Binding [CertDlg_Btn_OpenPki], Source={x:Static loc:Loc.Instance}}" />
                    </WrapPanel>

                    <!-- Painel de detalhes do certificado de servidor selecionado -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Background="{StaticResource SurfaceAltBrush}"
                            Padding="10,7" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Subject:" Style="{StaticResource SecondaryText}" Margin="0,0,6,0" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="SelectedServerSubjectBox" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0" Text="—" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Application URI:" Style="{StaticResource SecondaryText}" Margin="12,0,6,0" />
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="SelectedServerUriBox" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0" Text="—" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Thumbprint (SHA-1):" Style="{StaticResource SecondaryText}" Margin="0,0,6,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="SelectedServerThumbBox" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="12" Text="—" />

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Validity / Key:" Style="{StaticResource SecondaryText}" Margin="12,0,6,0" />
                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="SelectedServerValidityBox" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0" Text="—" />
                        </Grid>
                    </Border>

                    <!-- Tabela unificada de certificados de servidores -->
                    <Border Style="{StaticResource Panel}">
                        <DataGrid x:Name="ServersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" RowHeight="27" GridLinesVisibility="Horizontal"
                                  SelectionChanged="ServersGrid_SelectionChanged">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding [CertDlg_Btn_Trust], Source={x:Static loc:Loc.Instance}}" Click="TrustSelectedServer_Click" />
                                    <MenuItem Header="{Binding [CertDlg_Btn_Reject], Source={x:Static loc:Loc.Instance}}" Click="RejectSelectedServer_Click" />
                                    <Separator />
                                    <MenuItem Header="{Binding [CertDlg_Btn_ExportServer], Source={x:Static loc:Loc.Instance}}" Click="ExportSelectedServerCert_Click" />
                                    <MenuItem Header="{Binding [CertDlg_Btn_DeleteServer], Source={x:Static loc:Loc.Instance}}" Click="RemoveSelectedServerCert_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status" Binding="{Binding TrustStatusText}" Width="95" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="2*" />
                                <DataGridTextColumn Header="Application URI" Binding="{Binding ApplicationUri}" Width="1.4*" />
                                <DataGridTextColumn Header="Validity" Binding="{Binding ValidityRangeText}" Width="155" />
                                <DataGridTextColumn Header="State" Binding="{Binding ValidityStatusText}" Width="150" />
                                <DataGridTextColumn Header="Thumbprint (SHA-1)" Binding="{Binding Thumbprint}" Width="1.4*" FontFamily="{StaticResource MonoFont}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ===================================================================== -->
            <!-- ABA 2: DESCOBERTA DE CERTIFICADOS DE SERVIDORES (DISCOVERY)           -->
            <!-- ===================================================================== -->
            <TabItem x:Name="DiscoveryTab" Header="{Binding [CertDlg_Tab_Discovery], Source={x:Static loc:Loc.Instance}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Background="{StaticResource SurfaceAltBrush}"
                            Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Endpoint URL:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" x:Name="DiscoveryUrlCombo" IsEditable="True"
                                          Padding="6,4" Margin="0,0,8,0" />
                                <Button Grid.Column="2" x:Name="DiscoverBtn" Click="DiscoverServerCerts_Click"
                                        Padding="14,5" BorderBrush="{StaticResource AccentBrush}" Background="{StaticResource AccentSoftBrush}"
                                        FontWeight="SemiBold" Content="{Binding [CertDlg_Btn_Discover], Source={x:Static loc:Loc.Instance}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Ações sobre o certificado descoberto -->
                    <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="TrustDiscoveredBtn" Click="TrustDiscoveredCert_Click" Padding="12,5" Margin="0,2,6,2"
                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                Content="{Binding [CertDlg_Btn_Trust], Source={x:Static loc:Loc.Instance}}" />
                        <Button x:Name="RejectDiscoveredBtn" Click="RejectDiscoveredCert_Click" Padding="12,5" Margin="0,2,6,2"
                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                Content="{Binding [CertDlg_Btn_Reject], Source={x:Static loc:Loc.Instance}}" />
                        <Button x:Name="ExportDiscoveredBtn" Click="ExportDiscoveredCert_Click" Padding="12,5" Margin="0,2,0,2"
                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                Content="{Binding [CertDlg_Btn_ExportServer], Source={x:Static loc:Loc.Instance}}" />
                    </WrapPanel>

                    <Border Style="{StaticResource Panel}">
                        <DataGrid x:Name="DiscoveredCertsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" RowHeight="27" GridLinesVisibility="Horizontal"
                                  SelectionChanged="DiscoveredCertsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Status" Binding="{Binding Certificate.TrustStatusText}" Width="100" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Subject" Binding="{Binding Certificate.Subject}" Width="1.8*" />
                                <DataGridTextColumn Header="Application URI" Binding="{Binding Certificate.ApplicationUri}" Width="1.3*" />
                                <DataGridTextColumn Header="Endpoints" Binding="{Binding EndpointsDisplay}" Width="1.6*" />
                                <DataGridTextColumn Header="Validity" Binding="{Binding Certificate.ValidityRangeText}" Width="155" />
                                <DataGridTextColumn Header="Bits" Binding="{Binding Certificate.KeySize}" Width="80" />
                                <DataGridTextColumn Header="Thumbprint (SHA-1)" Binding="{Binding Certificate.Thumbprint}" Width="1.4*" FontFamily="{StaticResource MonoFont}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ===================================================================== -->
            <!-- ABA 3: MEU CERTIFICADO (CLIENTE OPC UA)                               -->
            <!-- ===================================================================== -->
            <TabItem x:Name="ClientCertTab" Header="{Binding [CertDlg_Tab_Client], Source={x:Static loc:Loc.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Seção A: Certificado atual em uso pelo cliente -->
                        <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding [CertDlg_Tab_Client], Source={x:Static loc:Loc.Instance}}"
                                           Style="{StaticResource PanelHeaderText}" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Subject:" Style="{StaticResource SecondaryText}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ClientSubjectBox" IsReadOnly="True"
                                             Background="Transparent" BorderThickness="0" FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Application URI:" Style="{StaticResource SecondaryText}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ClientUriBox" IsReadOnly="True"
                                             Background="Transparent" BorderThickness="0" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Thumbprint (SHA-1):" Style="{StaticResource SecondaryText}" />
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="ClientThumbprintBox" IsReadOnly="True"
                                             Background="Transparent" BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="12" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Validity:" Style="{StaticResource SecondaryText}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="ClientValidityText" FontWeight="SemiBold" />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Key / Algorithm:" Style="{StaticResource SecondaryText}" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" x:Name="ClientKeyInfoText" Style="{StaticResource SecondaryText}" />

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="PKI Folder:" Style="{StaticResource SecondaryText}" />
                                    <TextBox Grid.Row="10" Grid.Column="1" x:Name="PkiPathBox" IsReadOnly="True"
                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>

                                <WrapPanel Orientation="Horizontal">
                                    <Button Click="ExportClientDer_Click" Padding="12,5" Margin="0,2,8,2"
                                            BorderBrush="{StaticResource AccentBrush}" Background="{StaticResource AccentSoftBrush}"
                                            FontWeight="SemiBold"
                                            Content="{Binding [CertDlg_Btn_ExportClientDer], Source={x:Static loc:Loc.Instance}}" />
                                    <Button Click="OpenPkiFolder_Click" Padding="10,5" Margin="0,2,0,2"
                                            BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                            Content="{Binding [CertDlg_Btn_OpenPki], Source={x:Static loc:Loc.Instance}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Seção B: Gerar Novo Certificado de Cliente com escolha de data de validade -->
                        <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding [CertDlg_Btn_GenerateClient], Source={x:Static loc:Loc.Instance}}"
                                           Style="{StaticResource PanelHeaderText}" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Common Name (CN):" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="GenCommonNameBox" Text="DMapFactory OPC UA Client" Padding="6,4" Margin="0,0,12,0" />

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Organization (O):" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="GenOrganizationBox" Text="DMapFactory" Padding="6,4" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Not Before:" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                                    <DatePicker Grid.Row="2" Grid.Column="1" x:Name="GenNotBeforePicker" Margin="0,0,12,0" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Key Size:" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                                    <ComboBox Grid.Row="2" Grid.Column="3" x:Name="GenKeySizeCombo" SelectedIndex="0" Padding="6,4" VerticalAlignment="Center">
                                        <ComboBoxItem Content="2048 bits" Tag="2048" />
                                        <ComboBoxItem Content="3072 bits" Tag="3072" />
                                        <ComboBoxItem Content="4096 bits" Tag="4096" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Not After:" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                                    <DatePicker Grid.Row="4" Grid.Column="1" x:Name="GenNotAfterPicker" Margin="0,0,12,0" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Preset:" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                                    <WrapPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="+1Y" Tag="1" Click="PresetValidityYears_Click" Padding="7,3" Margin="0,1,4,1"
                                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}" />
                                        <Button Content="+2Y" Tag="2" Click="PresetValidityYears_Click" Padding="7,3" Margin="0,1,4,1"
                                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}" />
                                        <Button Content="+5Y" Tag="5" Click="PresetValidityYears_Click" Padding="7,3" Margin="0,1,4,1"
                                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}" />
                                        <Button Content="+10Y" Tag="10" Click="PresetValidityYears_Click" Padding="7,3" Margin="0,1,0,1"
                                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}" />
                                    </WrapPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Click="GenerateClientCert_Click" Padding="14,6"
                                            BorderBrush="{StaticResource AccentBrush}" Background="{StaticResource AccentSoftBrush}"
                                            FontWeight="SemiBold"
                                            Content="{Binding [CertDlg_Btn_GenerateClient], Source={x:Static loc:Loc.Instance}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Seção C: Menu Escondido "Avançado" (Q3) -->
                        <Border Style="{StaticResource Panel}" Padding="10,6">
                            <Expander x:Name="AdvancedClientExpander" Header="PKCS#12 (.pfx)" IsExpanded="False">
                                <StackPanel Margin="0,8,0,4">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Click="ExportClientPfx_Click" Padding="10,5" Margin="0,2,8,2"
                                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                Content="{Binding [CertDlg_Btn_ExportClientPfx], Source={x:Static loc:Loc.Instance}}" />
                                        <Button Click="ImportClientCert_Click" Padding="10,5" Margin="0,2,0,2"
                                                BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceAltBrush}"
                                                Content="{Binding [CertDlg_Btn_ImportClient], Source={x:Static loc:Loc.Instance}}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Mensagem de status -->
        <TextBlock Grid.Row="1" x:Name="StatusText" Style="{StaticResource SecondaryText}"
                   Margin="0,8,0,6" TextWrapping="Wrap" />

        <!-- Rodapé -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="18,5" IsCancel="True" IsDefault="True" Content="{Binding [CertDlg_Close], Source={x:Static loc:Loc.Instance}}" />
        </StackPanel>
    </Grid>
</Window>
