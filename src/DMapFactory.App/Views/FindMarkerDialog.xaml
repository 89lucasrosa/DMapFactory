<Window x:Class="DMapFactory.App.Views.FindMarkerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:DMapFactory.Localization;assembly=DMapFactory.Localization"
        mc:Ignorable="d"
        Title="{Binding [FindMarker_Title], Source={x:Static loc:Loc.Instance}}"
        Width="680" Height="480" MinWidth="520" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="🚩" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding [FindMarker_Header], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Style="{StaticResource SecondaryText}" FontSize="11"
                           Text="{Binding [FindMarker_Subheader], Source={x:Static loc:Loc.Instance}}" />
            </StackPanel>
        </StackPanel>

        <!-- Barra de Filtro / Busca -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding [FindMarker_FilterLabel], Source={x:Static loc:Loc.Instance}}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" x:Name="SearchTextBox" Padding="6,3" VerticalAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged" />
                <Button Grid.Column="2" Content="{Binding [FindMarker_BtnClear], Source={x:Static loc:Loc.Instance}}" Margin="6,0,0,0" Padding="8,2" Click="ClearSearchButton_Click" />
            </Grid>
        </Border>

        <!-- Tabela de Marcadores -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource ControlRadius}" Background="{StaticResource SurfaceBrush}">
            <DataGrid x:Name="MarkersGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      VerticalGridLinesBrush="{StaticResource BorderBrush}"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      FontFamily="{StaticResource MonoFont}"
                      FontSize="12"
                      RowHeight="26"
                      BorderThickness="0"
                      SelectionChanged="MarkersGrid_SelectionChanged"
                      MouseDoubleClick="MarkersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Width="55" Binding="{Binding RowDisplay}" />
                    <DataGridTextColumn x:Name="ColTimestamp" Header="Timestamp (UTC)" Width="180" Binding="{Binding TimestampDisplay}" />
                    <DataGridTextColumn x:Name="ColComment" Header="Marcador / Comentário" Width="*" Binding="{Binding Text}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3" x:Name="StatusTextBlock" Style="{StaticResource SecondaryText}" Margin="2,8,2,12" />

        <!-- Botões de Ação -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="FocusChartButton" Content="{Binding [FindMarker_BtnFocusChart], Source={x:Static loc:Loc.Instance}}" Padding="10,4" Margin="0,0,6,0"
                        Click="FocusChartButton_Click" IsEnabled="False" />
                <Button x:Name="LocateSpreadsheetButton" Content="{Binding [FindMarker_BtnLocateGrid], Source={x:Static loc:Loc.Instance}}" Padding="10,4" Margin="0,0,6,0"
                        Click="LocateSpreadsheetButton_Click" IsEnabled="False" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="EditMarkerButton" Content="{Binding [FindMarker_BtnEdit], Source={x:Static loc:Loc.Instance}}" Padding="10,4" Margin="0,0,6,0"
                        Click="EditMarkerButton_Click" IsEnabled="False" />
                <Button x:Name="DeleteMarkerButton" Content="{Binding [FindMarker_BtnDelete], Source={x:Static loc:Loc.Instance}}" Padding="10,4" Margin="0,0,10,0"
                        Click="DeleteMarkerButton_Click" IsEnabled="False" />
                <Button Content="{Binding [FindMarker_BtnClose], Source={x:Static loc:Loc.Instance}}" IsCancel="True" Padding="14,4" Click="CloseButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
