<Window x:Class="DMapFactory.App.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DMapFactory.Localization;assembly=DMapFactory.Localization"
        Title="{Binding [ConnDialog_Title], Source={x:Static loc:Loc.Instance}}"
        Width="560" Height="500" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Nome e Endpoint -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                       Text="{Binding [ConnDialog_Name], Source={x:Static loc:Loc.Instance}}" />
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Padding="6,4"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                       Text="{Binding [ConnDialog_Endpoint], Source={x:Static loc:Loc.Instance}}" />
            <TextBox Grid.Row="2" Grid.Column="1" Padding="6,4"
                     Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="2" Grid.Column="2" Margin="6,0,0,0" Padding="10,4"
                    Command="{Binding DiscoverCommand}"
                    Content="{Binding [ConnDialog_Discover], Source={x:Static loc:Loc.Instance}}" />
        </Grid>

        <!-- Endpoints descobertos -->
        <TextBlock Grid.Row="1" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"
                   Text="{Binding [ConnDialog_DiscoveredList], Source={x:Static loc:Loc.Instance}}" />
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,10">
            <ListBox ItemsSource="{Binding DiscoveredEndpoints}"
                     SelectedItem="{Binding SelectedDiscoveredEndpoint}"
                     DisplayMemberPath="DisplayText"
                     Background="Transparent" BorderThickness="0" />
        </Border>

        <!-- Segurança e Autenticação -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                       Text="{Binding [ConnDialog_SecurityPolicy], Source={x:Static loc:Loc.Instance}}" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Policies}"
                      SelectedItem="{Binding SelectedPolicy}" DisplayMemberPath="ShortName" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                       Text="{Binding [ConnDialog_SecurityMode], Source={x:Static loc:Loc.Instance}}" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SecurityModes}"
                      SelectedItem="{Binding SelectedMode}" />

            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                       Text="{Binding [ConnDialog_Auth], Source={x:Static loc:Loc.Instance}}" />
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AuthModes}"
                      SelectedItem="{Binding SelectedAuth}" />

            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"
                       Visibility="{Binding IsUserPasswordVisible, Converter={StaticResource BoolToVis}}"
                       Text="{Binding [ConnDialog_UserName], Source={x:Static loc:Loc.Instance}}" />
            <TextBox Grid.Row="6" Grid.Column="1" Padding="6,4"
                     Visibility="{Binding IsUserPasswordVisible, Converter={StaticResource BoolToVis}}"
                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"
                       Visibility="{Binding IsUserPasswordVisible, Converter={StaticResource BoolToVis}}"
                       Text="{Binding [ConnDialog_Password], Source={x:Static loc:Loc.Instance}}" />
            <PasswordBox x:Name="UserPasswordBox" Grid.Row="8" Grid.Column="1" Padding="6,4"
                         Visibility="{Binding IsUserPasswordVisible, Converter={StaticResource BoolToVis}}"
                         PasswordChar="●" PasswordChanged="UserPasswordBox_PasswordChanged" />

            <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center"
                       Visibility="{Binding IsCertificateVisible, Converter={StaticResource BoolToVis}}"
                       Text="{Binding [ConnDialog_UserCert], Source={x:Static loc:Loc.Instance}}" />
            <TextBox Grid.Row="10" Grid.Column="1" Padding="6,4"
                     Visibility="{Binding IsCertificateVisible, Converter={StaticResource BoolToVis}}"
                     Text="{Binding UserCertificatePath, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Status do teste -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"
                   Margin="0,0,0,10" TextWrapping="Wrap" />

        <!-- Botões -->
        <DockPanel Grid.Row="5">
            <Button DockPanel.Dock="Left" Padding="12,5"
                    Command="{Binding TestConnectionCommand}"
                    Content="{Binding [ConnDialog_Test], Source={x:Static loc:Loc.Instance}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Padding="14,5" Margin="0,0,6,0" IsDefault="True" Click="OnSaveClick"
                        Content="{Binding [ConnDialog_Save], Source={x:Static loc:Loc.Instance}}" />
                <Button Padding="14,5" IsCancel="True"
                        Content="{Binding [ConnDialog_Cancel], Source={x:Static loc:Loc.Instance}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
