<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DMapFactory.App</RootNamespace>
    <AssemblyName>DMapFactory</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Interface WPF do DMapFactory.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DMapFactory.Core\DMapFactory.Core.csproj" />
    <ProjectReference Include="..\DMapFactory.Localization\DMapFactory.Localization.csproj" />
    <ProjectReference Include="..\DMapFactory.Drivers.OpcUa\DMapFactory.Drivers.OpcUa.csproj" />
    <ProjectReference Include="..\DMapFactory.Storage\DMapFactory.Storage.csproj" />
    <ProjectReference Include="..\DMapFactory.Acquisition\DMapFactory.Acquisition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Help\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
